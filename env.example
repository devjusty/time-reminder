# Time Reminder App Environment Variables
# Copy this file to .env.local for local development overrides

# Debug Settings (optional - defaults work for most cases)
# VITE_DEBUG=true                    # Force enable debug logging in production
# VITE_LOG_LEVEL=info               # Log level: info, warn, error
# VITE_VERBOSE_STORAGE=true         # Enable verbose localStorage logging

# Development: Logging automatically enabled
# Production: Logging automatically disabled (unless VITE_DEBUG=true)

---
const publisherId = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID;
const adsenseScriptUrl = publisherId
  ? `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${publisherId}`
  : "";
const loaderScript = `
  if (!window.__timeReminderAdsenseLoaded) {
    window.__timeReminderAdsenseLoaded = true;
    const script = document.createElement("script");
    script.async = true;
    script.src = ${JSON.stringify(adsenseScriptUrl)};
    script.crossOrigin = "anonymous";
    document.body.append(script);
  }
`;
---

{publisherId && <script is:inline data-astro-rerun set:html={loaderScript} />}

<p id="schedule-status" role="status"></p>
<fieldset class="time-toggle-group">
  <legend>Schedule</legend>
  <label for="alarm1">Remind me at</label>
  <div class="time-toggles">
    <button
      class="time-button active"
      id="alarm1"
      data-remindtime="00"
      aria-pressed="true"
    >
      :00
    </button>
    <button
      class="time-button"
      id="alarm2"
      data-remindtime="15"
      aria-pressed="false"
    >
      :15
    </button>
    <button
      class="time-button"
      id="alarm3"
      data-remindtime="30"
      aria-pressed="false"
    >
      :30
    </button>
    <button
      class="time-button"
      id="alarm4"
      data-remindtime="45"
      aria-pressed="false"
    >
      :45
    </button>
  </div>
</fieldset>

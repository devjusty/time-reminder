<span id="digital-clock" role="timer" aria-label="Current time">00:00 AM</span>
<div class="clock-container">
  <div class="clock" aria-hidden="true">
    <div class="notch zero active"></div>
    <div class="notch fifteen"></div>
    <div class="notch thirty"></div>
    <div class="notch fortyfive"></div>
    <div class="needle hour"></div>
    <div class="needle minute"></div>
    <div class="needle second"></div>
    <div class="center-point"></div>
  </div>
</div>
<p id="audio-error" class="error-message" role="alert"></p>

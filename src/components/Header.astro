---
import { Image } from "astro:assets";
import TimeReminderLogo from "../assets/time-reminder-icon.png";
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header>
  <a class="brand" href="/" aria-label="Time Reminder home">
    <Image src={TimeReminderLogo} alt="" width={50} height={50} />
    <span class="name">Time Reminder</span>
  </a>
  <p class="about">
    An alternative to typical alarms and timers. Get reminders at the top of the
    hour, bottom of the hour, or the sides.
  </p>
</header>

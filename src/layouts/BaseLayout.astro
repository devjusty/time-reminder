---
import "../styles/global.css";
import { Font } from "astro:assets";
import { SEO } from "astro-seo";
import Footer from "../components/Footer.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";

const googleAnalyticsId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;

interface Props {
  title?: string;
  description?: string;
  canonical?: string | URL;
  socialImage?: string | URL;
  lang?: string;
}

const {
  title = "TimeReminder | Keep track of time",
  description = "Keep track of time with an alternative to typical alarms and timers. Get audible reminders at the top of the hour, bottom of the hour, or the sides.",
  canonical,
  socialImage = "/open-graph/home.png",
  lang = "en",
} = Astro.props;

const canonicalURL = canonical
  ? new URL(canonical, Astro.site)
  : new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(socialImage, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-distant-galaxy" />
    <SEO
      title={title}
      description={description}
      canonical={canonicalURL}
      removeTrailingSlashForRoot
      openGraph={{
        basic: {
          title,
          type: "website",
          image: socialImageURL.href,
          url: canonicalURL.href,
        },
        image: {
          url: socialImageURL.href,
          alt: "Sleep Time Reminder",
        },
        optional: {
          description,
          locale: "en_US",
          siteName: "Sleep Time Reminder",
        },
      }}
      twitter={{
        card: "summary_large_image",
        title,
        description,
        image: socialImageURL.href,
        imageAlt: "Sleep Time Reminder bedtime calculator",
      }}
    />
    <slot name="head" />
    {googleAnalyticsId && <GoogleAnalytics measurementId={googleAnalyticsId} />}
  </head>
  <body>
    <slot />
    <Footer />
  </body>
</html>

---
import Layout from "../layouts/BaseLayout.astro";
---

<Layout
  title="Contact | Time Reminder"
  description="Contact Time Reminder by email or through GitHub."
>
  <main id="main-content" class="contact-page" tabindex="-1">
    <h1>Contact</h1>
    <p>
      Email <a href="mailto:hello@timeremind.info">hello@timeremind.info</a>
      or visit the project on
      <a href="https://github.com/devjusty/time-reminder">GitHub</a>.
    </p>
  </main>
</Layout>

<style>
  .contact-page {
    width: min(100%, 44rem);
    padding: var(--spacing-large);
    background: var(--white);
    border-radius: var(--border-radius);
    box-shadow:
      rgba(50, 50, 93, 0.15) 0 15px 30px -12px,
      rgba(0, 0, 0, 0.15) 0 10px 20px -14px;
  }

  .contact-page h1 {
    color: var(--primary-dark);
    margin-bottom: var(--spacing-medium);
  }

  .contact-page p {
    color: var(--primary-text);
    line-height: 1.6;
  }

  .contact-page a {
    color: var(--primary);
    text-underline-offset: 2px;
  }

  .contact-page a:hover {
    color: var(--primary-light);
  }

  @media screen and (max-width: 768px) {
    .contact-page {
      padding: var(--spacing-medium);
    }
  }
</style>

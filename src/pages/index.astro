---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Clock from "../components/Clock.astro";
import RemindUntil from "../components/RemindUntil.astro";
import TimeToggles from "../components/TimeToggles.astro";
import Volume from "../components/Volume.astro";
---

<BaseLayout>
  <main class="app" aria-labelledby="app-title">
    <h1 id="app-title" class="visually-hidden">TimeReminder</h1>
    <Clock />
    <TimeToggles />
    <RemindUntil />
    <Volume />
  </main>
  <script src="../scripts/time-reminder.ts"></script>
</BaseLayout>
